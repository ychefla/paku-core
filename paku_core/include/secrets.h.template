// OTA Update Configuration (optional - for firmware updates)
// The device will listen for OTA commands on MQTT topic:
//   paku/devices/{device_id}/cmd/ota
// 
// Command format (JSON):
// {
//   "url": "https://your-server.com/firmware/paku-core-v1.2.0.bin",
//   "checksum": "sha256-hex-string",
//   "version": "1.2.0"
// }
//
// The firmware binary should be accessible via HTTP/HTTPS.
// Checksum is optional but highly recommended for security.
// After successful update, the device will automatically reboot.
//
// Example OTA server URL (replace with your actual server):
// #define OTA_SERVER_URL "https://ota.paku.example.com/firmware"
//
// For signature verification (future enhancement):
// #define OTA_PUBLIC_KEY "-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

