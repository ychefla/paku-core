// MQTT Broker — Cloud
// Used as fallback when local HA broker is unreachable, or as primary on
// foreign networks. Set to your cloud MQTT host.
#define MQTT_SERVER                   "your-cloud-mqtt.example.com"
#define MQTT_PORT                     8883    // Cloud: TLS recommended
#define MQTT_USER                     "paku-edge"
#define MQTT_PASSWORD                 "changeme"
// #define MQTT_USE_TLS               1       // Uncomment to enable TLS for cloud

// MQTT TLS Configuration (for cloud broker)
// If your cloud broker uses TLS (port 8883), provide the CA certificate.
// Extract from your cloud broker, e.g.:
//   docker run --rm your-mosquitto cat /mosquitto/certs/ca.crt
// #define MQTT_CA_CERT \
// "-----BEGIN CERTIFICATE-----\n" \
// "MIIDDzCCAfeg...(paste full CA cert here)...\n" \
// "-----END CERTIFICATE-----\n"

// MQTT Broker — Local (RPi / Home Assistant)
// The ESP32 will try this broker first. Uses mDNS (homeassistant.local) by
// default; set a static IP as fallback if mDNS is unreliable on your network.
#define MQTT_LOCAL                    "homeassistant.local"
#define MQTT_LOCAL_PORT               1883    // Local broker: plain TCP
#define MQTT_LOCAL_USER               ""      // Leave empty for anonymous
#define MQTT_LOCAL_PASSWORD           ""      // Leave empty for anonymous

